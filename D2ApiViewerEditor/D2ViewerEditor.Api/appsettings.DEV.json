{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "BuildInfo": {
    "Environment": "DEV"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=d2viewereditor;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Swagger": {
    "Enabled": true
  },
  "GoogleCloudStorage": {
    "BucketName": "d2viewereditor-documents",
    "ApiEndpoint": "http://localhost:4443"
  },
  "Security": {
    "ReturnUrl": {
      "RequireHttps": false,
      "AllowLoopback": true,
      "AllowPrivateNetworkIp": true
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<DEV_TENANT_ID>",
    "ClientId": "<DEV_API_CLIENT_ID>",
    "Scopes": [],
    "Proxy": {
      "Url": "",
      "Username": "",
      "Password": ""
    }
  },
  "Roles": {
    "GroupPrefix": "KUTAS_200_",
    "Roles": [
      {
        "RoleName": "Operator",
        "GroupNames": [ "<DEV_GROUP_PRACOWNIK>" ]
      },
      {
        "RoleName": "Administrator",
        "GroupNames": [ "<DEV_GROUP_ADMINISTRATOR>" ]
      }
    ]
  },
  "GCPSecretManager": {
    "Enabled": false,
    "ProjectId": "<GCP_PROJECT_ID>",
    "EntraSecretName": "<ENTRA_SECRET_NAME>"
  }
}
