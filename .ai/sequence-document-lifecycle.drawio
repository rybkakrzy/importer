<mxfile host="app.diagrams.net" type="device">
  <diagram name="Cykl pracy z dokumentem" id="doc-lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1870" math="0" shadow="1" background="#fbfbfd">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITLE BANNER ===================== -->
        <mxCell id="title" value="D2 ViewerEditor — Cykl pracy z dokumentem (sequence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23445d;strokeColor=none;fontColor=#ffffff;fontSize=18;fontStyle=1;align=left;spacingLeft=18;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="1000" height="30" as="geometry" />
