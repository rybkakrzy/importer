<mxfile host="app.diagrams.net" type="device">
  <diagram name="Cykl pracy z dokumentem" id="doc-lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITLE ===================== -->
        <mxCell id="title" value="D2 ViewerEditor — Cykl pracy z dokumentem (sequence)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="900" height="28" as="geometry" />
        </mxCell>

        <!-- ===================== LIFELINES ===================== -->
        <mxCell id="L1" value="Użytkownik" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="120" height="1760" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="Angular SPA&#10;(Editor / PDF Viewer)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="48" width="120" height="1760" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="Internal API&#10;DocumentStorageController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=30;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="460" y="48" width="120" height="1760" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="Application / Domain&#10;(MediatR handlers)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=30;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="680" y="48" width="120" height="1760" as="geometry" />
        </mxCell>
        <mxCell id="L5" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=30;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="900" y="48" width="120" height="1760" as="geometry" />
        </mxCell>
        <mxCell id="L6" value="Google Cloud&#10;Storage" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=30;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1100" y="48" width="120" height="1760" as="geometry" />
        </mxCell>
        <mxCell id="L7" value="DocumentDelivery&#10;Worker" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=30;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1320" y="48" width="120" height="1760" as="geometry" />
        </mxCell>
        <mxCell id="L8" value="ReturnUrl&#10;(odbiorca)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=30;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1540" y="48" width="120" height="1760" as="geometry" />
        </mxCell>

        <!-- ===================== FRAMES (alt/loop) ===================== -->
        <mxCell id="F1" value="alt [dokument nie istnieje]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;fontStyle=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="F2" value="alt [DOCX]  /  [PDF]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;fontStyle=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="1160" height="620" as="geometry" />
        </mxCell>
        <mxCell id="F2div" value="[PDF]" style="text;html=1;dashed=1;strokeColor=#6c8ebf;fillColor=none;align=left;verticalAlign=top;fontStyle=2;fontSize=11;labelPosition=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="1010" width="1160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="F2divline" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="1022" as="sourcePoint" />
            <mxPoint x="1240" y="1022" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="F3" value="loop [auto-save co 30 s, gdy włączony i jest versionId]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;fontStyle=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="860" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="F4" value="loop [polling co ~4 s do stanu końcowego]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;fontStyle=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="1410" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="F5" value="alt [wynik wysyłki]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;fontStyle=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1640" width="400" height="150" as="geometry" />
        </mxCell>

        <!-- ===================== NOTES ===================== -->
        <mxCell id="N0" value="[Wymaga potwierdzenia] Brak warstwy auth w repo — dostęp = znajomość masterId. Brak CorporateKey/allowedCorporateKeys." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="620" y="118" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="N1" value="classification → wspólny komponent badge (DOCX i PDF). Brak/empty → brak badge." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="250" y="528" width="300" height="44" as="geometry" />
        </mxCell>
        <mxCell id="N2" value="Płaski zapis (ADR-0003): nadpisanie v2 w miejscu. v1 chroniona (BR-002 → 400)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="610" y="900" width="290" height="44" as="geometry" />
        </mxCell>
        <mxCell id="N3" value="Snapshot niezmienny deliveries/{id} (SHA-256). Idempotencja: unique partial index (1 aktywne zadanie/dokument)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="610" y="1248" width="300" height="56" as="geometry" />
        </mxCell>

        <!-- ===================== MESSAGES ===================== -->
        <!-- Phase: load -->
        <mxCell id="e1" value="Wejście w URL ?masterId=[&amp;versionId=]" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="100" y="150" as="sourcePoint" /><mxPoint x="300" y="150" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="GET /{masterId}/metadata" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="190" as="sourcePoint" /><mxPoint x="520" y="190" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e3" value="GetDocumentMetadataQuery" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="520" y="230" as="sourcePoint" /><mxPoint x="740" y="230" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="GetByIdAsync(masterId)" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="270" as="sourcePoint" /><mxPoint x="960" y="270" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e5" value="Document | null" style="html=1;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="960" y="305" as="sourcePoint" /><mxPoint x="740" y="305" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- F1: not found -->
        <mxCell id="e6" value="404 { error }" style="html=1;endArrow=open;dashed=1;fontSize=11;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="520" y="362" as="sourcePoint" /><mxPoint x="300" y="362" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e7" value="„Nie znaleziono dokumentu&quot;" style="html=1;endArrow=open;dashed=1;fontSize=11;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="400" as="sourcePoint" /><mxPoint x="100" y="400" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- exists: returns -->
        <mxCell id="e8" value="{ mimeType, returnUrl?, classification? }" style="html=1;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="468" as="sourcePoint" /><mxPoint x="520" y="468" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e9" value="200 metadata" style="html=1;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="520" y="506" as="sourcePoint" /><mxPoint x="300" y="506" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- F2 DOCX branch -->
        <mxCell id="e11" value="GET .../versions/{versionId}/download (edycja)  |  /{masterId}/download (podgląd)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="618" as="sourcePoint" /><mxPoint x="520" y="618" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e12" value="DownloadAsync(documents/{versionId})" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="520" y="656" as="sourcePoint" /><mxPoint x="1160" y="656" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e13" value="bytes  (err → 5xx/404 do GUI)" style="html=1;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="694" as="sourcePoint" /><mxPoint x="520" y="694" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e14" value="plik (blob)" style="html=1;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="520" y="732" as="sourcePoint" /><mxPoint x="300" y="732" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e15" value="POST /api/document/open (DOCX → HTML)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="770" as="sourcePoint" /><mxPoint x="520" y="770" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e16" value="DocumentContent (HTML)" style="html=1;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="520" y="808" as="sourcePoint" /><mxPoint x="300" y="808" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e17" value="render edytora WYSIWYG" style="html=1;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="846" as="sourcePoint" /><mxPoint x="100" y="846" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- F3 autosave loop -->
        <mxCell id="e18" value="zmiany treści" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="100" y="912" as="sourcePoint" /><mxPoint x="300" y="912" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e19" value="PUT /{masterId}/versions/{versionId}  (nadpisanie v2 + SaveChanges, Status=Editing)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="952" as="sourcePoint" /><mxPoint x="520" y="952" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e20" value="200 / błąd → autoSaveStatus = saved | error" style="html=1;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="520" y="988" as="sourcePoint" /><mxPoint x="300" y="988" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- F2 PDF branch (below divider) -->
        <mxCell id="e21" value="GET /{masterId}  (DocumentDto z content base64)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="1060" as="sourcePoint" /><mxPoint x="520" y="1060" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e22" value="DownloadAsync(documents/{versionId})" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="520" y="1098" as="sourcePoint" /><mxPoint x="1160" y="1098" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e23" value="bytes" style="html=1;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="1136" as="sourcePoint" /><mxPoint x="520" y="1136" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e24" value="DocumentDto { content } → render pdfjs (+ badge klasyfikacji)" style="html=1;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="520" y="1174" as="sourcePoint" /><mxPoint x="300" y="1174" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Finish phase -->
        <mxCell id="e25" value="klik „Zakończ&quot;" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="100" y="1228" as="sourcePoint" /><mxPoint x="300" y="1228" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e26" value="POST /{masterId}/versions/{versionId}/finish  (brak/zły ReturnUrl → 400)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="1266" as="sourcePoint" /><mxPoint x="520" y="1266" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e27" value="UploadAsync(v2) + UploadRawAsync(deliveries/{id}) snapshot" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="520" y="1320" as="sourcePoint" /><mxPoint x="1160" y="1320" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e28" value="1 transakcja: Status=Sending + INSERT document_deliveries(Pending)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="520" y="1358" as="sourcePoint" /><mxPoint x="960" y="1358" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e29" value="202 { deliveryId, statusUrl }" style="html=1;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="520" y="1396" as="sourcePoint" /><mxPoint x="300" y="1396" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- F4 polling loop -->
        <mxCell id="e30" value="GET /deliveries/{deliveryId} → { status, attemptCount, lastError? }" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="1455" as="sourcePoint" /><mxPoint x="520" y="1455" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Worker phase -->
        <mxCell id="e31" value="ClaimDueBatch (SELECT ... FOR UPDATE SKIP LOCKED + lease)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="1535" as="sourcePoint" /><mxPoint x="960" y="1535" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e32" value="DownloadAsync(deliveries/{id})" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="1575" as="sourcePoint" /><mxPoint x="1160" y="1575" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e33" value="POST snapshot (Idempotency-Key=deliveryId, X-Content-SHA256)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="1615" as="sourcePoint" /><mxPoint x="1600" y="1615" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- F5 result -->
        <mxCell id="e34" value="2xx → MarkSent + Document.Status=Sent" style="html=1;endArrow=open;dashed=1;fontSize=10;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1600" y="1672" as="sourcePoint" /><mxPoint x="1380" y="1672" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e35" value="5xx/timeout → ScheduleRetry (backoff+jitter); po 24h → DeadLettered" style="html=1;endArrow=open;dashed=1;fontSize=10;strokeColor=#d79b00;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1600" y="1718" as="sourcePoint" /><mxPoint x="1380" y="1718" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="e36" value="4xx (400/401/403/404/405/422) → FailedPermanently" style="html=1;endArrow=open;dashed=1;fontSize=10;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1600" y="1762" as="sourcePoint" /><mxPoint x="1380" y="1762" as="targetPoint" /></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
