        <mxCell id="legend" value="━ wywołanie&#10;┄ powrót / wynik" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#5b6770;" vertex="1" parent="1">
          <mxGeometry x="1060" y="8" width="180" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== LIFELINES ===================== -->
        <mxCell id="L1" value="Użytkownik" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=34;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;rounded=1;shadow=1;" vertex="1" parent="1">
